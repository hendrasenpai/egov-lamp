#!/bin/bash
# ==============================================================================
# EGOV-LAMP CONTROL CENTER
# Multi-PHP Development Environment (7.4, 8.0, 8.1, 8.2, 8.3)
# ==============================================================================

GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
RED='\033[0;31m'
BOLD='\033[1m'
PURPLE='\033[0;35m'
NC='\033[0m' # No Color

# Auto-detect root directory of egov-lamp
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "$SCRIPT_DIR/../docker-compose.yml" ]; then
    ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
elif [ -f "./docker-compose.yml" ]; then
    ROOT_DIR="$(pwd)"
elif [ -d "/home/hendra/workspace/egov" ]; then
    ROOT_DIR="/home/hendra/workspace/egov"
fi

cd "$ROOT_DIR" || { echo -e "${RED}Direktori egov-lamp tidak ditemukan!${NC}"; exit 1; }

# Handle subcommands langsung dari terminal (contoh: egov clone <nama_repo>, egov init <nama_project>, egov delete <nama_project>)
if [ "$1" == "clone" ]; then
    shift
    exec bash "$SCRIPT_DIR/clone-project.sh" "$@"
elif [ "$1" == "init" ]; then
    shift
    exec bash "$SCRIPT_DIR/init-project.sh" "$@"
elif [ "$1" == "delete" ] || [ "$1" == "rm" ]; then
    shift
    exec bash "$SCRIPT_DIR/delete-project.sh" "$@"
elif [ "$1" == "update" ] || [ "$1" == "upgrade" ]; then
    shift
    exec bash "$SCRIPT_DIR/update-lamp.sh" "$@"
elif [ "$1" == "fix-perms" ] || [ "$1" == "fix" ]; then
    shift
    source "$SCRIPT_DIR/docker-php-helpers.sh"
    fix-perms "$@"
    exit $?
fi

clear
echo -e "${CYAN}=====================================================${NC}"
echo -e "${CYAN}   🏛️   E-GOVERNMENT DISKOMINFO KABUPATEN BINTAN      ${NC}"
echo -e "${CYAN}       Multi-PHP Local Development Environment       ${NC}"
echo -e "${CYAN}=====================================================${NC}"
echo -e "Direktori : ${YELLOW}$ROOT_DIR${NC}"
echo ""
echo -e "Pilih aksi yang ingin dilakukan:"
echo -e "  ${GREEN}1)${NC} Nyalakan PHP Tertentu (Pilih Versi: 7.4 - 8.5)"
echo -e "  ${GREEN}2)${NC} Nyalakan Default / Rekomendasi (PHP 7.4 + DB + PMA)"
echo -e "  ${GREEN}3)${NC} Nyalakan SEMUA Versi PHP Sekaligus"
echo -e "  ${RED}4)${NC} Matikan Semua Container egov-lamp"
echo -e "  ${YELLOW}5)${NC} Cek Status Container Aktif"
echo -e "  ${BLUE}6)${NC} Perbaiki Permission Folder (fix-perms)"
echo -e "  ${CYAN}7)${NC} Clone Project dari GitHub (tim-it-diskominfobintan)"
echo -e "  ${PURPLE}8)${NC} Inisialisasi Project Baru (Template core-laravel)"
echo -e "  ${RED}9)${NC} Hapus Project Lokal & Database (Delete / Clean)"
echo -e "  ${CYAN}10)${NC} 🚀 Cek & Update egov-lamp (Git Pull)"
echo -e "  ${BOLD}0)${NC} Keluar"
echo ""
read -p "Masukkan pilihan [0-10]: " ACTION_CHOICE

case $ACTION_CHOICE in
    1)
        echo ""
        echo -e "Pilih versi PHP (bisa lebih dari satu, pisahkan spasi, contoh: 1 5 7):"
        echo -e "  ${BOLD}1)${NC} PHP 7.4 (Port :8074)"
        echo -e "  ${BOLD}2)${NC} PHP 8.0 (Port :8080)"
        echo -e "  ${BOLD}3)${NC} PHP 8.1 (Port :8081)"
        echo -e "  ${BOLD}4)${NC} PHP 8.2 (Port :8082)"
        echo -e "  ${BOLD}5)${NC} PHP 8.3 (Port :8083)"
        echo -e "  ${BOLD}6)${NC} PHP 8.4 (Port :8084)"
        echo -e "  ${BOLD}7)${NC} PHP 8.5 (Port :8085)"
        echo ""
        read -p "Pilihan versi: " -a VERSIONS

        SERVICES="database phpmyadmin redis"
        DASH_PORTS=()
        for v in "${VERSIONS[@]}"; do
            case $v in
                1|7.4|74|php74) SERVICES="$SERVICES php74"; DASH_PORTS+=("8074") ;;
                2|8.0|80|php80) SERVICES="$SERVICES php80"; DASH_PORTS+=("8080") ;;
                3|8.1|81|php81) SERVICES="$SERVICES php81"; DASH_PORTS+=("8081") ;;
                4|8.2|82|php82) SERVICES="$SERVICES php82"; DASH_PORTS+=("8082") ;;
                5|8.3|83|php83) SERVICES="$SERVICES php83"; DASH_PORTS+=("8083") ;;
                6|8.4|84|php84) SERVICES="$SERVICES php84"; DASH_PORTS+=("8084") ;;
                7|8.5|85|php85) SERVICES="$SERVICES php85"; DASH_PORTS+=("8085") ;;
            esac
        done

        echo ""
        echo -e "${YELLOW}Menyalakan service: $SERVICES...${NC}"
        docker compose up -d $SERVICES
        echo ""
        echo -e "${GREEN}✔ Berhasil dinyalakan!${NC}"
        if [ ${#DASH_PORTS[@]} -eq 1 ]; then
            echo -e "Dashboard Web : ${CYAN}http://localhost:${DASH_PORTS[0]}${NC}"
        elif [ ${#DASH_PORTS[@]} -gt 1 ]; then
            echo -e "Dashboard Web :"
            for p in "${DASH_PORTS[@]}"; do
                echo -e "  - ${CYAN}http://localhost:${p}${NC}"
            done
        else
            echo -e "Dashboard Web : ${CYAN}http://localhost:8085${NC} (atau sesuai port PHP yang aktif)"
        fi
        echo -e "phpMyAdmin    : ${CYAN}http://localhost:8888${NC}"
        echo -e "MariaDB Port  : ${CYAN}3306${NC} (user: root/docker, pass: tiger/docker)"
        ;;
    2)
        echo ""
        echo -e "${YELLOW}Menyalakan mode Default (PHP 7.4 + DB + phpMyAdmin + Redis)...${NC}"
        docker compose up -d database phpmyadmin redis php74
        echo ""
        echo -e "${GREEN}✔ Berhasil dinyalakan!${NC}"
        echo -e "Dashboard Web : ${CYAN}http://localhost:8074${NC}"
        echo -e "phpMyAdmin    : ${CYAN}http://localhost:8888${NC}"
        ;;
    3)
        echo ""
        echo -e "${YELLOW}Menyalakan SEMUA container (PHP 7.4, 8.0, 8.1, 8.2, 8.3, 8.4, 8.5)...${NC}"
        docker compose up -d
        echo ""
        echo -e "${GREEN}✔ Semua container aktif!${NC}"
        echo -e "Dashboard Web : ${CYAN}http://localhost:8085${NC} (tersedia di semua port :8074 s/d :8085)"
        echo -e "phpMyAdmin    : ${CYAN}http://localhost:8888${NC}"
        echo -e "MariaDB Port  : ${CYAN}3306${NC} (user: root/docker, pass: tiger/docker)"
        ;;
    4)
        echo ""
        echo -e "${RED}Mematikan semua container egov-lamp...${NC}"
        docker compose down
        echo -e "${GREEN}✔ Container berhasil dimatikan.${NC}"
        ;;
    5)
        echo ""
        echo -e "${CYAN}--- Status Container egov-lamp ---${NC}"
        docker ps --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}" | grep -E "egov-|CONTAINER ID"
        ;;
    6)
        echo ""
        source "$SCRIPT_DIR/docker-php-helpers.sh"
        read -p "Masukkan nama folder project (kosongkan untuk semua project): " TARGET_PERM
        fix-perms "$TARGET_PERM"
        ;;
    7)
        bash "$SCRIPT_DIR/clone-project.sh"
        ;;
    8)
        bash "$SCRIPT_DIR/init-project.sh"
        ;;
    9)
        bash "$SCRIPT_DIR/delete-project.sh"
        ;;
    10|[Uu]|update)
        bash "$SCRIPT_DIR/update-lamp.sh"
        ;;
    0)
        exit 0
        ;;
    *)
        echo -e "${RED}Pilihan tidak valid.${NC}"
        exit 1
        ;;
esac
